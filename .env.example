# Shared passcode all editors use at /admin/sign-in. Required in production.
EDITOR_PASSCODE=change-me
# Long random string used to sign cookies (e.g. `openssl rand -hex 32`). Required in production.
COOKIE_SECRET=
# Secret ntfy.sh topic for owner push notifications. Leave empty to disable.
NTFY_TOPIC=
# Public URL guests use (your Cloudflare Tunnel hostname). Used for absolute "my claims" links.
PUBLIC_URL=https://shower.example.se
# SQLite file. In Docker this lives on the /data volume.
DATABASE_PATH=/data/registry.db
# Directory for uploads (DATA_DIR/uploads).
DATA_DIR=/data

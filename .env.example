# Shared passcode all editors use at /admin/sign-in. Required in production.
EDITOR_PASSCODE=change-me
# Long random string used to sign cookies (e.g. `openssl rand -hex 32`). Required in production.
COOKIE_SECRET=
# Secret ntfy.sh topic for owner push notifications. Leave empty to disable.
NTFY_TOPIC=
# Public URL guests use (your Cloudflare Tunnel hostname). Used for absolute "my claims" links.
PUBLIC_URL=https://shower.example.se
# SQLite file. In Docker, /data is the ./data folder next to docker-compose.yml.
DATABASE_PATH=/data/registry.db
# Directory for uploads (DATA_DIR/uploads).
DATA_DIR=/data
# Optional: Anthropic API key for the admin "Auto-translate" button (Claude Haiku, fractions of a cent per
# registry). Leave empty to use the free MyMemory API instead. Never commit a real key.
ANTHROPIC_API_KEY=
# Optional: anthropic | mymemory | none. Empty picks anthropic when a key is set, else mymemory.
# "none" hides the Auto-translate button.
TRANSLATE_PROVIDER=
